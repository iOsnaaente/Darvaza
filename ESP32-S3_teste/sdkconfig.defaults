CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Callback de fim de transferência do LCD e ISR do SPI em IRAM
CONFIG_SPI_MASTER_ISR_IN_IRAM=y
# Gravar a flash (animações, NVS) desliga o cache dos dois cores: estas ISRs
# continuam rodando (I2S não perde bloco, a UART a 2 Mbaud não transborda)
CONFIG_I2S_ISR_IRAM_SAFE=y
CONFIG_UART_ISR_IN_IRAM=y
# Partição "anims" para as animações
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_IDF_TARGET="esp32p4"
# O chip da placa é rev v1.3. O IDF 5.5 compila por padrão para rev >= 3.01,
# que é outro hardware: sem isto o bootloader recusa o chip.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# Waveshare ESP32-P4-Module-DEV-KIT: 16 MB de flash (esptool flash_id: c8/4018).
# Os exemplos da IMX708 assumem 32 MB; header maior que o chip falha no boot.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# app de 7 MB (modelos de rosto ficam no rodata) + FATFS "storage" com o face.db
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# who_task usa o core de cada tarefa e as run-time stats
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FATFS_LFN_HEAP=y

# PSRAM de 32 MB do módulo. 200 MHz fica atrás do flag experimental; sem ele
# cai em 20 MHz e a câmera não consegue escrever o frame a tempo.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=n

# esp_video: MIPI-CSI + ISP (RAW10 da IMX708 -> RGB565 para o modelo)
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# Pi Camera Module 3 (IMX708). Modo 1 = 1280x720 @ 28 fps (56% do campo de
# visão): 1,8 MB por frame RGB565 x 6 buffers. O modo 0 (1920x1080) daria
# 25 MB só de buffers, sem espaço para os modelos.
CONFIG_CAMERA_IMX708=y
CONFIG_CAMERA_IMX708_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_IMX708_MIPI_IF_FORMAT_INDEX_DEFAULT=1
CONFIG_CAMERA_IMX219=n

# Autofoco (motor DW9807 no I2C 0x0c). Sem ele a lente fica parada além do
# infinito e todo rosto sai borrado. Os três últimos precisam estar todos
# ligados: falta de qualquer um desliga o AF sem aviso.
CONFIG_CAM_MOTOR_DW9807=y
CONFIG_CAM_MOTOR_DW9807_AUTO_DETECT=y
CONFIG_ESP_IPA_AF_ALGORITHM=y
CONFIG_ESP_VIDEO_ENABLE_CAMERA_MOTOR_CONTROLLER=y
CONFIG_ESP_VIDEO_ISP_PIPELINE_CONTROL_CAMERA_MOTOR=y
